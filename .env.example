# ──────────────────────────────────────────────────────────────────
# .env.example — Environment Variables for URL Shortener
#
# Copy this file: cp .env.example .env
# Then fill in your own values before running docker-compose up
# NEVER commit your real .env file to version control!
# ──────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# ── Redis ──
REDIS_PASSWORD=your_redis_password_here
CACHE_TTL_SECONDS=3600           # How long (seconds) to cache URL lookups in Redis

# ── Application ──
BASE_URL=http://localhost:8000   # Public-facing base URL of your backend
                                  # Change to your Railway/Render URL in production
                                  # Example: https://urlshortener-api.up.railway.app

# ── CORS ──
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# In production: set to your frontend domain
# Example: https://yourapp.vercel.app

# ── Database URL (auto-built by docker-compose but can override here) ──
# DATABASE_URL=postgresql://postgres:your_strong_password_here@db:5432/urlshortener

# ── Redis URL (auto-built by docker-compose but can override here) ──
# REDIS_URL=redis://:your_redis_password_here@redis:6379/0
